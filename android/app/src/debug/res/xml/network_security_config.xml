<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only override of the release policy in src/main.

  The Firebase emulator suite speaks plain HTTP, and the app is otherwise
  forbidden from cleartext entirely — so without this, running against the
  local stack fails at the first request with no obvious cause.

  Two things keep this narrow. It lives in the debug source set, so the release
  build keeps src/main's blanket `cleartextTrafficPermitted="false"`; and the
  exception names only the two addresses that mean "this machine" — 10.0.2.2 is
  how an Android emulator reaches its host, 127.0.0.1 is a device forwarding a
  port over adb. Everything else stays HTTPS-only even in debug.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <debug-overrides>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </debug-overrides>
</network-security-config>
