# Firebase web app config. Public by design - these ship to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=loyaltyos-fc4dd.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=loyaltyos-fc4dd

# Server-only.
FIREBASE_PROJECT_ID=loyaltyos-fc4dd

# Cloud Functions HTTP API base URL, no trailing slash.
# Local emulator example:
#   http://127.0.0.1:5099/loyaltyos-fc4dd/us-central1/api
ADMIN_API_BASE_URL=https://us-central1-loyaltyos-fc4dd.cloudfunctions.net/api

# Optional. When omitted, Application Default Credentials are used
# (gcloud auth application-default login, or the Cloud Run service identity).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
