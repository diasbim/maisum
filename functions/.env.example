# Runtime configuration for the Cloud Functions API.
#
# Copy to `.env.<projectId>` — e.g. `.env.loyaltyos-fc4dd` — which is
# gitignored. Secrets do NOT belong here: those are declared with
# `defineSecret` in src/index.ts and live in Secret Manager.

# ── Customer app feature flags ───────────────────────────────────────────────
# Each gates a slice of the customer-facing API. Off means the endpoints answer
# "disabled" rather than 404, so the app can explain instead of looking broken.
CUSTOMER_APP_ENABLED=true
CUSTOMER_REDEMPTION_ENABLED=true
CUSTOMER_QR_ENABLED=true
CUSTOMER_PUSH_ENABLED=true
CUSTOMER_DEEP_LINKS_ENABLED=true

# ── Survey links ─────────────────────────────────────────────────────────────
# Where `/q/<token>` is served — the portal's own origin, without a trailing
# slash. A customer-facing host on purpose: the link is sent over WhatsApp, and
# a message pointing at "admin.…" reads like something to be suspicious of.
# Both domains map to the same App Hosting backend.
#
# Leave unset and the link endpoint returns `url: null`; the app then says
# "sem endereço público configurado" instead of sending a customer nowhere.
SURVEY_LINK_BASE_URL=https://inqueritos.maisum.tsintsivadigital.com

# ── Optional ─────────────────────────────────────────────────────────────────
# Extra browser origins allowed to call the API, comma-separated. The portal
# calls from its own server and needs no entry here; see src/cors_origins.ts.
# ALLOWED_ORIGINS=

# Retention scan tuning. The defaults in src/index.ts are the intended values;
# set these only to work around a specific run.
# RETENTION_SCAN_LIMIT=
# RETENTION_SCAN_MAX_PAGES=
# RETENTION_SCAN_TIME_BUDGET_MS=

# ── Prospeção com IA ─────────────────────────────────────────────────────────
# O módulo de aquisição de clientes na consola (Comercial → Prospeção).
# Desligado significa que os endpoints respondem "desativado" em vez de 404, por
# isso o portal explica em vez de parecer avariado.
AI_PROSPECTING_ENABLED=false

# Enriquecimento automático. Fica desligado: é o único caminho que gasta
# dinheiro sem alguém o ter pedido.
AUTO_ENRICHMENT_ENABLED=false

# Geração de mensagens. Gera; nunca envia.
AI_OUTREACH_ENABLED=false

# Fornecedores de dados, um por um. Um fornecedor sem chave é ignorado pela
# cadeia sem ser chamado, por isso ligar a flag sem a chave não custa nada —
# mas também não faz nada.

# Google Places é a fonte primária: descobre os negócios e, numa segunda
# chamada mais cara, devolve telefone, site, horário e fotografias. As duas
# metades estão separadas de propósito — a cara só é feita sobre um negócio
# que já passou o limiar de pontuação (`min_score_for_enrichment`), que é o
# controlo de custo de todo o módulo.
PROSPECTING_PLACES_ENABLED=false

# Apollo continua ligado e funcional, mas fora da ordem por omissão: é a metade
# cara do pipeline antigo (decisores, número de funcionários). Para o voltar a
# usar, ligue esta flag e ponha 'apollo' à frente em Definições → Prospeção.
PROSPECTING_APOLLO_ENABLED=false
# AIsa é a pesquisa web do módulo: um gateway sobre milhares de APIs, do qual
# se usa o Perplexity Sonar. Não tem procura de pessoas, por isso não entra nas
# cadeias de descoberta nem de contactos. É o único fornecedor que comunica o
# custo real de cada chamada (cabeçalho X-AISA-Price-USD).
PROSPECTING_AISA_ENABLED=false

# Dados fictícios, para o emulador e para o seed de desenvolvimento. NUNCA em
# produção: são negócios que não existem.
PROSPECTING_FIXTURES_ENABLED=false

# O modelo. Deixe ANTHROPIC_API_KEY por definir e não há custo de IA nenhum:
# `resolveLlm` devolve um modelo que recusa, as rotas de análise respondem
# "nenhum modelo configurado" em vez de 500, e a consola explica a ausência.
# Nada precisa de ser apagado para desligar a IA — basta não haver chave.
# PROSPECTING_MODEL=claude-opus-5

# As chaves dos fornecedores e do modelo NÃO pertencem aqui. São declaradas com
# `defineSecret` em src/index.ts e vivem no Secret Manager:
#
#   GOOGLE_PLACES_API_KEY chave do Google Places (descoberta + ficha do negócio)
#   APOLLO_API_KEY        chave da Apollo (organização, pessoas, enriquecimento)
#   AISA_API_KEY          pesquisa web (formato sk-aisa-…)
#   ANTHROPIC_API_KEY     modelo — por definir enquanto o MVP correr sem IA
#
# Os endereços base são configuração, não segredo, e só se definem para apontar
# a um duplo em testes de integração.
# GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1
# APOLLO_BASE_URL=https://api.apollo.io/api/v1
# AISA_BASE_URL=https://api.aisa.one/apis/v1
