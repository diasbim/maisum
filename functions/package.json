{
  "name": "loyaltyos-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "codegen": "tsc src/plan_policy_codegen.ts --outDir lib --module node16 --moduleResolution node16 --target es2020 --types node --skipLibCheck && node scripts/generate_plan_policy.js",
    "test": "npm run build --silent && node --test lib/*.test.js",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "express": "^4.19.2",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "typescript": "^5.5.4"
  }
}
