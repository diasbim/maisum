rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Mirrors functions/src/admin_access.ts -> hasAdminClaims().
    // Parity is asserted by functions/src/admin_access.test.ts; if you change
    // the accepted claims here, change them there and in
    // lib/features/auth/presentation/auth_controller.dart too.
    function hasAdminRoleClaim() {
      return 'role' in request.auth.token &&
        request.auth.token.role is string && (
          request.auth.token.role.trim().lower() == 'admin' ||
          request.auth.token.role.trim().lower() == 'internal_admin'
        );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.is_admin == true ||
        request.auth.token.internal_admin == true ||
        hasAdminRoleClaim()
      );
    }

    function hasOwnerClaim() {
      return isSignedIn() && (
        request.auth.token.app_user_role == 'OWNER' ||
        request.auth.token.appUserRole == 'OWNER' ||
        request.auth.token.role == 'OWNER'
      );
    }

    function hasStaffClaim() {
      return isSignedIn() && (
        request.auth.token.app_user_role == 'STAFF' ||
        request.auth.token.appUserRole == 'STAFF' ||
        request.auth.token.role == 'STAFF'
      );
    }

    function merchantClaimMatches(merchantId) {
      return isSignedIn() && (
        request.auth.token.merchant_id == merchantId ||
        request.auth.token.merchantId == merchantId ||
        (request.auth.token.merchant_ids is list &&
          merchantId in request.auth.token.merchant_ids) ||
        (request.auth.token.merchantIds is list &&
          merchantId in request.auth.token.merchantIds)
      );
    }

    function businessDoc(merchantId) {
      return get(/databases/$(database)/documents/businesses/$(merchantId));
    }

    function isBusinessOwner(merchantId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/businesses/$(merchantId)) && (
          businessDoc(merchantId).data.owner_user_id == request.auth.uid ||
          businessDoc(merchantId).data.firebase_uid == request.auth.uid
        );
    }

    function canAccessBusiness(merchantId) {
      return isAdmin() ||
        merchantClaimMatches(merchantId) ||
        isBusinessOwner(merchantId) ||
        authPhoneMatchesBusiness(merchantId);
    }

    function canBootstrapBusiness(merchantId) {
      return isSignedIn() && (
        merchantId == request.auth.uid ||
        request.resource.data.owner_user_id == request.auth.uid ||
        request.resource.data.firebase_uid == request.auth.uid
      );
    }

    function canBootstrapBusinessRead(merchantId) {
      return isSignedIn() && merchantId == request.auth.uid;
    }

    function hasBusinessOwnerFields(merchantId) {
      return exists(/databases/$(database)/documents/businesses/$(merchantId)) && (
        (businessDoc(merchantId).data.owner_user_id is string &&
          businessDoc(merchantId).data.owner_user_id != '') ||
        (businessDoc(merchantId).data.firebase_uid is string &&
          businessDoc(merchantId).data.firebase_uid != '')
      );
    }

    function authPhoneMatchesBusiness(merchantId) {
      return exists(/databases/$(database)/documents/businesses/$(merchantId)) &&
        request.auth.token.phone_number is string &&
        businessDoc(merchantId).data.phone == request.auth.token.phone_number;
    }

    function authPhoneMatchesListedBusiness() {
      return request.auth.token.phone_number is string &&
        resource.data.phone == request.auth.token.phone_number;
    }

    function canListBusinessDoc() {
      return isSignedIn() &&
        request.query.limit != null &&
        request.query.limit <= 1 && (
          resource.data.owner_user_id == request.auth.uid ||
          resource.data.firebase_uid == request.auth.uid ||
          authPhoneMatchesListedBusiness()
        );
    }

    function canClaimLegacyBusiness(merchantId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/businesses/$(merchantId)) &&
        !hasBusinessOwnerFields(merchantId) &&
        (merchantId == request.auth.uid || authPhoneMatchesBusiness(merchantId)) &&
        request.resource.data.owner_user_id == request.auth.uid &&
        request.resource.data.firebase_uid == request.auth.uid;
    }

    function canClaimPhoneMatchedBusiness(merchantId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/businesses/$(merchantId)) &&
        authPhoneMatchesBusiness(merchantId) &&
        request.resource.data.phone == businessDoc(merchantId).data.phone &&
        request.resource.data.owner_user_id == businessDoc(merchantId).data.owner_user_id &&
        request.resource.data.firebase_uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'created_at',
          'device_id',
          'firebase_uid',
          'id',
          'link_code',
          'link_code_normalized',
          'subscription_status',
          'updated_at'
        ]);
    }

    function canReadLegacyBusiness(merchantId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/businesses/$(merchantId)) &&
        !hasBusinessOwnerFields(merchantId) &&
        (merchantId == request.auth.uid || authPhoneMatchesBusiness(merchantId));
    }

    function isClientWritableOperationalCollection(collectionId) {
      return collectionId in [
        'customers',
        'merchant_items',
        'sales',
        'sale_items',
        'rewards',
        'appointments',
        'retention_metrics',
        'customer_risk_scores',
        'recovery_tasks',
        'recovery_task_open_slots',
        'recovery_actions',
        'visit_reports',
        'surveys',
        'survey_questions',
        'survey_responses',
        'survey_response_answers',
        'app_users'
      ];
    }

    function isReadableBusinessCollection(collectionId) {
      return collectionId in [
        'customers',
        'merchant_items',
        'sales',
        'sale_items',
        'rewards',
        'redemptions',
        'appointments',
        'retention_metrics',
        'customer_risk_scores',
        'recovery_tasks',
        'recovery_task_open_slots',
        'recovery_actions',
        'visit_reports',
        'surveys',
        'survey_questions',
        'survey_responses',
        'survey_response_answers',
        'subscription_state',
        'entitlements',
        'feature_flags',
        'remote_config',
        'app_users',
        'loyalty_ledger',
        'domain_events',
        'retention_policies',
        'customer_transitions',
        'customer_recommendations',
        'usage_balances',
        'usage_events',
        'notification_queue',
        'return_bonuses'
      ];
    }

    function canManageBusinessProfile(merchantId) {
      return canAccessBusiness(merchantId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'id',
          'merchant_name',
          'phone',
          'city',
          'district',
          'address',
          'reference',
          'location',
          'business_type',
          'business_profile_version',
          'working_hours',
          'services',
          'created_at',
          'updated_at',
          'device_id'
        ]);
    }

    function canManageAppUsers(merchantId) {
      return isAdmin() ||
        isBusinessOwner(merchantId) ||
        merchantClaimMatches(merchantId) ||
        authPhoneMatchesBusiness(merchantId);
    }

    function customerClientWritableFields() {
      return [
        'id',
        'merchant_id',
        'device_id',
        'name',
        'phone',
        'total_points',
        'marketing_consent_status',
        'whatsapp_consent_status',
        'created_at',
        'updated_at',
        'synced'
      ];
    }

    function customerMerchantIdMatchesPath(merchantId) {
      return !request.resource.data.keys().hasAny(['merchant_id']) ||
        request.resource.data.merchant_id == merchantId;
    }

    function customerIdMatchesPath(docId) {
      return !request.resource.data.keys().hasAny(['id']) ||
        request.resource.data.id == docId;
    }

    function customerCreateIsValid(merchantId, docId) {
      return request.resource.data.keys().hasOnly(customerClientWritableFields()) &&
        customerMerchantIdMatchesPath(merchantId) &&
        customerIdMatchesPath(docId);
    }

    function customerUpdateIsValid(merchantId, docId) {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(customerClientWritableFields()) &&
        customerMerchantIdMatchesPath(merchantId) &&
        customerIdMatchesPath(docId) &&
        (!resource.data.keys().hasAny(['merchant_id']) ||
          request.resource.data.merchant_id == resource.data.merchant_id) &&
        (!resource.data.keys().hasAny(['id']) ||
          request.resource.data.id == resource.data.id);
    }

    function saleClientWritableFields() {
      return [
        'id',
        'merchant_id',
        'customer_id',
        'amount',
        'points',
        'created_at',
        'updated_at',
        'device_id',
        'created_by_app_user_id',
        'updated_by_app_user_id',
        'synced'
      ];
    }

    function saleMerchantIdMatchesPath(merchantId) {
      return !request.resource.data.keys().hasAny(['merchant_id']) ||
        request.resource.data.merchant_id == merchantId;
    }

    function saleIdMatchesPath(docId) {
      return !request.resource.data.keys().hasAny(['id']) ||
        request.resource.data.id == docId;
    }

    function saleHasRequiredShape() {
      return request.resource.data.customer_id is string &&
        request.resource.data.customer_id != '' &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        (!request.resource.data.keys().hasAny(['points']) ||
          request.resource.data.points is number) &&
        (!request.resource.data.keys().hasAny(['created_at']) ||
          request.resource.data.created_at is number) &&
        (!request.resource.data.keys().hasAny(['updated_at']) ||
          request.resource.data.updated_at is number);
    }

    // What a referred sale carries, and why a client may not write any of it.
    //
    // A referral's benefit, its gross amount and the code behind it are decided
    // by the commit transaction in the Cloud Functions, which also writes the
    // attribution, the affiliate's reward and the code's usage count in the
    // same breath. A till that could set these fields directly could hand
    // itself a discount and claim an acquisition that never happened, without
    // any of the other records existing to contradict it.
    //
    // `saleClientWritableFields` already excludes them, so this is the same
    // refusal said out loud: it names the fields, and a future edit that adds
    // one to the writable list fails here rather than silently opening a door.
    function saleServerOwnedReferralFields() {
      return [
        'gross_amount',
        'referral_benefit_type',
        'referral_benefit_value',
        'referral_benefit_amount',
        'affiliate_code_id',
        'affiliate_id',
        'referral_status',
        'referral_idempotency_key',
        'referral_request_hash',
        // Written only by the offline reconciliation, and for the same reason
        // as the rest: `referral_offline_benefit_applied` is what stops the
        // server taking back a discount a customer has already been given, so a
        // till that could set it could keep any discount it liked.
        'referral_source',
        'referral_offline_benefit_applied',
        'referral_rejection_reason'
      ];
    }

    function saleCarriesNoReferralClaim() {
      return !request.resource.data.keys().hasAny(saleServerOwnedReferralFields());
    }

    function saleReferralFieldsUnchanged() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(saleServerOwnedReferralFields());
    }

    function saleCreateIsValid(merchantId, docId) {
      return request.resource.data.keys().hasOnly(saleClientWritableFields()) &&
        saleCarriesNoReferralClaim() &&
        saleMerchantIdMatchesPath(merchantId) &&
        saleIdMatchesPath(docId) &&
        saleHasRequiredShape();
    }

    function saleUpdateIsValid(merchantId, docId) {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(saleClientWritableFields()) &&
        saleReferralFieldsUnchanged() &&
        saleMerchantIdMatchesPath(merchantId) &&
        saleIdMatchesPath(docId) &&
        (!resource.data.keys().hasAny(['merchant_id']) ||
          request.resource.data.merchant_id == resource.data.merchant_id) &&
        (!resource.data.keys().hasAny(['id']) ||
          request.resource.data.id == resource.data.id) &&
        (
          !resource.data.keys().hasAny(['confirmation_status']) ||
          resource.data.confirmation_status != 'CONFIRMED' ||
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['synced'])
        ) &&
        saleHasRequiredShape();
    }

    match /businesses/{merchantId} {
      // Entry flow query by phone uses limit(1); keep narrow list access.
      allow list: if canListBusinessDoc();
      allow get: if canAccessBusiness(merchantId) || canBootstrapBusinessRead(merchantId) || canReadLegacyBusiness(merchantId);
      allow create: if isAdmin() || canBootstrapBusiness(merchantId);
      allow update: if isAdmin() || canManageBusinessProfile(merchantId) || canClaimLegacyBusiness(merchantId) || canClaimPhoneMatchedBusiness(merchantId);
      allow delete: if isAdmin() || isBusinessOwner(merchantId);

      // Business-scoped collections. Server-owned collections remain read-only to clients.
      match /{collectionId}/{docId} {
        allow read: if isReadableBusinessCollection(collectionId) && canAccessBusiness(merchantId);

        allow create: if collectionId == 'customers' &&
          canAccessBusiness(merchantId) &&
          customerCreateIsValid(merchantId, docId);
        allow update: if collectionId == 'customers' &&
          canAccessBusiness(merchantId) &&
          customerUpdateIsValid(merchantId, docId);
        allow delete: if collectionId == 'customers' && canAccessBusiness(merchantId);

        allow create: if collectionId == 'sales' &&
          canAccessBusiness(merchantId) &&
          saleCreateIsValid(merchantId, docId);
        allow update: if collectionId == 'sales' &&
          canAccessBusiness(merchantId) &&
          saleUpdateIsValid(merchantId, docId);

        allow create, update, delete: if collectionId == 'app_users' &&
          canManageAppUsers(merchantId);

        allow create, update, delete: if isClientWritableOperationalCollection(collectionId) &&
          collectionId != 'customers' &&
          collectionId != 'sales' &&
          collectionId != 'app_users' &&
          canAccessBusiness(merchantId);
      }

      match /loyalty_ledger/{docId} {
        allow read: if canAccessBusiness(merchantId);
        allow write: if false;
      }

      match /domain_events/{docId} {
        allow read: if canAccessBusiness(merchantId);
        allow write: if false;
      }

      match /retention_policies/{docId} {
        allow read: if canAccessBusiness(merchantId);
        allow write: if false;
      }

      match /customer_transitions/{docId} {
        allow read: if canAccessBusiness(merchantId);
        allow write: if false;
      }

      match /customer_recommendations/{docId} {
        allow read: if canAccessBusiness(merchantId);
        allow write: if false;
      }

      // ── Affiliates ──────────────────────────────────────────────────────
      //
      // Every one of these is server-owned. The app and the portal reach them
      // through the Cloud Functions API, which runs with the Admin SDK and so
      // bypasses these rules entirely; no client reads or writes here, ever.
      //
      // The reason is not tidiness. A code's usageCount, an attribution and a
      // reward are the record of who earned what — a till that could edit them
      // could award itself money. And the uniqueness the feature depends on
      // ("one live attribution per customer") is enforced by a transaction on
      // the server; a direct client write would step around it.
      //
      match /affiliate_merchants/{affiliateId} {
        allow read, write: if false;
      }

      match /affiliate_codes/{codeId} {
        allow read, write: if false;
      }

      match /affiliate_attributions/{attributionId} {
        allow read, write: if false;
      }

      match /affiliate_rewards/{rewardId} {
        allow read, write: if false;
      }

      match /affiliate_events/{eventId} {
        allow read, write: if false;
      }

      // The messages the product sends about a referral: written inside the
      // sale transaction and delivered afterwards by the outbox worker, which
      // composes every body from the stored template and reads every number
      // from the merchant's own records. A client that could write one could
      // make the product send arbitrary WhatsApp in the business's name, to a
      // number of its choosing; a client that could read one could harvest
      // customer and affiliate phone numbers. Neither is ever allowed —
      // including the retry fields, which a client that could edit them could
      // use to replay a message indefinitely.
      match /affiliate_outbox/{outboxId} {
        allow read, write: if false;
      }

      match /affiliate_fraud_signals/{signalId} {
        allow read, write: if false;
      }

      match /affiliate_rate_limits/{bucketId} {
        allow read, write: if false;
      }
    }

    // The global affiliate identity and the code lookup that guarantees one
    // code per string across every business. Both are server-owned: the lookup
    // in particular is how a collision is detected inside a transaction, so a
    // client that could write it could claim another affiliate's code.
    match /affiliates/{affiliateId} {
      allow read, write: if false;
    }

    match /affiliate_code_lookup/{normalizedCode} {
      allow read, write: if false;
    }

    match /customer_identities/{docId} {
      allow read, write: if false;
    }

    match /business_customer_identity_links/{docId} {
      allow read, write: if false;
    }

    match /canonical_identity_business_links/{docId} {
      allow read, write: if false;
    }

    match /customer_accounts/{firebaseUid} {
      allow read, write: if false;
    }

    match /customer_identity_account_links/{canonicalCustomerId} {
      allow read, write: if false;
    }

    match /customer_analytics_events/{eventId} {
      allow read, write: if false;
    }

    // FCM registration tokens are accepted only by authenticated Functions.
    match /customer_push_tokens/{tokenId} {
      allow read, write: if false;
    }

    // Global plan catalog used by onboarding/settings plan selectors.
    // Administrative audit trail. Written only by the Admin SDK, which
    // bypasses these rules; no client ever reads or writes it. Spelled out
    // rather than left to the default deny so the intent is explicit next to
    // the collections that are readable.
    match /admin_audit_events/{eventId} {
      allow read, write: if false;
    }

    match /plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Global onboarding catalog/defaults used by merchant setup screens.
    match /merchant_onboarding_config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Prospeção ────────────────────────────────────────────────────────
    // The acquisition funnel: businesses MaisUm might sell to, before they
    // are merchants. Written only by the Admin SDK behind the internal-admin
    // claim, and read only through the `/admin/prospecting/*` API — no client
    // ever touches these paths.
    //
    // Closed to everyone rather than opened to `isAdmin()`, deliberately.
    // These documents hold contact details of people at businesses that have
    // not asked to hear from MaisUm, and an admin's browser session is not
    // the right place to be able to enumerate them. The API is the only door,
    // and it leaves an audit trail; a Firestore console read would not.
    //
    // Spelled out one by one rather than left to the default deny, so the
    // intent is explicit next to the collections that are readable.
    match /prospects/{prospectId} {
      allow read, write: if false;

      match /{collectionId}/{docId} {
        allow read, write: if false;
      }
    }

    match /prospect_companies/{companyId} {
      allow read, write: if false;
    }

    // The deduplication keys. Closed for the same reason as the companies:
    // a normalised phone number is a contact detail.
    match /prospect_company_lookup/{keyId} {
      allow read, write: if false;
    }

    match /prospecting_usage/{usageId} {
      allow read, write: if false;
    }

    match /prospecting_spend/{periodKey} {
      allow read, write: if false;
    }

    match /prospecting_settings/{configId} {
      allow read, write: if false;
    }

    match /prospecting_jobs/{jobId} {
      allow read, write: if false;
    }

    match /prospecting_rate_limits/{bucketId} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
